# Place esp32.wasm here.
# See the integration guide (Step 1) for download instructions:
#
# Option A — Build from Wokwi's open-source repo:
#   git clone https://github.com/wokwi/wokwi-esp32-basic-zig
#   cd wokwi-esp32-basic-zig && zig build -Doptimize=ReleaseFast
#   cp zig-out/lib/wokwi-esp32-basic.wasm ../esp32-wasm/esp32.wasm
#
# Option B — Download pre-built binary:
#   curl -L "https://wokwi.com/api/wasm/xtensa-esp32-elf/wokwi-esp32-basic.wasm" \
#        -o esp32.wasm
