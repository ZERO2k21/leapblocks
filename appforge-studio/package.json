{
  "name": "appforge-studio",
  "version": "0.1.0",
  "description": "AppForge Studio — Build Android apps with drag-and-drop components and block coding",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "dev": "concurrently \"cross-env BROWSER=none PORT=3456 react-scripts start\" \"wait-on http://localhost:3456 && electron .\"",
    "pack:win": "react-scripts build && electron-builder --win --config electron-builder.config.js",
    "pack:mac": "react-scripts build && electron-builder --mac --config electron-builder.config.js",
    "pack:linux": "react-scripts build && electron-builder --linux --config electron-builder.config.js",
    "pack:all": "react-scripts build && electron-builder --win --mac --linux --config electron-builder.config.js",
    "start:server": "node local-build-server/server.js",
    "test:server": "curl http://localhost:3001/health"
  },
  "keywords": [
    "appforge",
    "android",
    "app-builder",
    "blockly",
    "electron"
  ],
  "author": "AppForge",
  "license": "MIT",
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.13.6",
    "blockly": "^12.5.1",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "^5.0.1",
    "uuid": "^11.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "wait-on": "^9.0.4"
  }
}
