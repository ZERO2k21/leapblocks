{
  "name": "leapblocks-server",
  "version": "1.0.0",
  "description": "Unified LeapBlocks server: Arduino compile, transpile, APK build, and TCP proxy",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "proxy": "node tcp-proxy.js",
    "start:all": "concurrently \"npm run start\" \"npm run proxy\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.3.4",
    "pako": "^2.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "arduino",
    "esp32",
    "compiler",
    "simulator",
    "electra",
    "leapblocks"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "prisma": "^7.8.0"
  }
}
