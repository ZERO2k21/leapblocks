// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SharedProject {
  id        String   @id @default(cuid()) // Alphanumeric unique slug
  name      String   @default("Untitled Project")
  board     String   @default("arduino-uno")
  code      String
  nodes     String   // Stringified JSON array of React Flow nodes
  edges     String   // Stringified JSON array of React Flow edges
  libraries String   // Stringified JSON array of library strings
  createdAt DateTime @default(now())
}
