  "blockLogic": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n<block type=\"global_declaration\" id=\"g_qr_url\"><field name=\"NAME\">qrURL</field><value name=\"VALUE\"><block type=\"text\" id=\"init_qr_url\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"global_declaration\" id=\"g_input_text\"><field name=\"NAME\">inputText</field><value name=\"VALUE\"><block type=\"text\" id=\"init_input_text\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"component_event\" id=\"evt_init\"><mutation component_type=\"Screen\" event_name=\"Initialize\" instance_name=\"Screen1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Screen1</field><statement name=\"DO\"><block type=\"component_method\" id=\"alert_welcome\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_welcome\"><field name=\"TEXT\">Welcome to QR Code Generator</field></block></value></block></statement></block>\n<block type=\"component_event\" id=\"evt_generate_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnGenerate\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnGenerate</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_generate_qrcode\"><mutation name=\"GenerateQRCode\"></mutation><field name=\"NAME\">GenerateQRCode</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_save_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnSave\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnSave</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_save_qrcode\"><mutation name=\"SaveQRCode\"></mutation><field name=\"NAME\">SaveQRCode</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_share_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnShare\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnShare</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_share_qrcode\"><mutation name=\"ShareQRCode\"></mutation><field name=\"NAME\">ShareQRCode</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_copy_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnCopy\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnCopy</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_copy_text\"><mutation name=\"CopyText\"></mutation><field name=\"NAME\">CopyText</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_clear_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnClear\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnClear</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_clear_form\"><mutation name=\"ClearForm\"></mutation><field name=\"NAME\">ClearForm</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_got_file\"><mutation component_type=\"Web\" event_name=\"GotFile\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_web_got_file_success\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_resp_200\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_got_file_code\"><field name=\"VAR\">responseCode</field></block></value><value name=\"B\"><block type=\"math_number\" id=\"n_200\"><field name=\"NUM\">200</field></block></value></block></value><statement name=\"DO0\"><block type=\"component_method\" id=\"alert_saved_success\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_saved_success\"><field name=\"TEXT\">QR Code Saved Successfully</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_internet_req\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_internet_req\"><field name=\"TEXT\">Internet Connection Required</field></block></value></block></statement></block></statement></block>\n<block type=\"procedures_defnoreturn\" id=\"p_generate_qrcode\"><mutation></mutation><field name=\"NAME\">GenerateQRCode</field><statement name=\"STACK\"><block type=\"lexical_variable_set\" id=\"set_input_text\"><field name=\"VAR\">inputText</field><value name=\"VALUE\"><block type=\"component_get_property\" id=\"get_input_text\"><mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtInput\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">txtInput</field><field name=\"PROPERTY\">Text</field></block></value><next><block type=\"controls_if\" id=\"if_input_empty\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_input_empty\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_input_text_cmp\"><field name=\"VAR\">inputText</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_empty_val\"><field name=\"TEXT\"></field></block></value></block></value><statement name=\"DO0\"><block type=\"component_method\" id=\"alert_please_enter_text\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_please_enter_text\"><field name=\"TEXT\">Please Enter Text</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"lexical_variable_set\" id=\"set_qr_url\"><field name=\"VAR\">qrURL</field><value name=\"VALUE\"><block type=\"text_join\" id=\"tj_qr_url\"><mutation items=\"3\"></mutation><value name=\"ADD0\"><block type=\"text\" id=\"t_api_prefix\"><field name=\"TEXT\">https://quickchart.io/qr?text=</field></block></value><value name=\"ADD1\"><block type=\"component_method\" id=\"encode_input_text\"><mutation component_type=\"Web\" method_name=\"UriEncode\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><value name=\"ARG_text\"><block type=\"lexical_variable_get\" id=\"get_input_text_val\"><field name=\"VAR\">inputText</field></block></value></block></value><value name=\"ADD2\"><block type=\"text\" id=\"t_api_suffix\"><field name=\"TEXT\">&amp;size=300</field></block></value></block></value><next><block type=\"component_set_property\" id=\"set_img_picture\"><mutation component_type=\"Image\" property_name=\"Picture\" instance_name=\"imgQRCode\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">imgQRCode</field><field name=\"PROPERTY\">Picture</field><value name=\"VALUE\"><block type=\"lexical_variable_get\" id=\"get_qr_url_val\"><field name=\"VAR\">qrURL</field></block></value></block></next></block></statement></block></next></block></statement></block>\n<block type=\"procedures_defnoreturn\" id=\"p_save_qrcode\"><mutation></mutation><field name=\"NAME\">SaveQRCode</field><statement name=\"STACK\"><block type=\"controls_if\" id=\"if_save_empty\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_save_empty\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_qr_url_save\"><field name=\"VAR\">qrURL</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_empty_save\"><field name=\"TEXT\"></field></block></value></block></value><statement name=\"DO0\"><block type=\"component_method\" id=\"alert_save_empty\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_save_empty\"><field name=\"TEXT\">Please Generate QR Code First</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"component_set_property\" id=\"set_web_url\"><mutation component_type=\"Web\" property_name=\"Url\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><field name=\"PROPERTY\">Url</field><value name=\"VALUE\"><block type=\"lexical_variable_get\" id=\"get_qr_url_save_val\"><field name=\"VAR\">qrURL</field></block></value><next><block type=\"component_set_property\" id=\"set_web_save_response\"><mutation component_type=\"Web\" property_name=\"SaveResponse\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><field name=\"PROPERTY\">SaveResponse</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"bool_save_resp_true\"><field name=\"BOOL\">TRUE</field></block></value><next><block type=\"component_set_property\" id=\"set_web_resp_filename\"><mutation component_type=\"Web\" property_name=\"ResponseFileName\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><field name=\"PROPERTY\">ResponseFileName</field><value name=\"VALUE\"><block type=\"text\" id=\"t_filename\"><field name=\"TEXT\">qrcode.png</field></block></value><next><block type=\"component_method\" id=\"call_web_get\"><mutation component_type=\"Web\" method_name=\"Get\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field></block></next></block></next></block></next></block></statement></block></statement></block>\n<block type=\"procedures_defnoreturn\" id=\"p_share_qrcode\"><mutation></mutation><field name=\"NAME\">ShareQRCode</field><statement name=\"STACK\"><block type=\"controls_if\" id=\"if_share_empty\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_share_empty\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_qr_url_share\"><field name=\"VAR\">qrURL</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_empty_share\"><field name=\"TEXT\"></field></block></value></block></value><statement name=\"DO0\"><block type=\"component_method\" id=\"alert_share_empty\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_share_empty\"><field name=\"TEXT\">Please Generate QR Code First</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"call_sharing\"><mutation component_type=\"Sharing\" method_name=\"ShareMessage\" instance_name=\"Sharing1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Sharing1</field><value name=\"ARG_message\"><block type=\"lexical_variable_get\" id=\"get_qr_url_share_val\"><field name=\"VAR\">qrURL</field></block></value></block></statement></block></statement></block>\n<block type=\"procedures_defnoreturn\" id=\"p_copy_text\"><mutation></mutation><field name=\"NAME\">CopyText</field><statement name=\"STACK\"><block type=\"controls_if\" id=\"if_copy_empty\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_copy_empty\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_input_text_copy\"><field name=\"VAR\">inputText</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_empty_copy\"><field name=\"TEXT\"></field></block></value></block></value><statement name=\"DO0\"><block type=\"component_method\" id=\"alert_copy_empty\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_copy_empty\"><field name=\"TEXT\">No Text to Copy</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_copied\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_copied\"><field name=\"TEXT\">Text Copied</field></block></value></block></statement></block></statement></block>\n<block type=\"procedures_defnoreturn\" id=\"p_clear_form\"><mutation></mutation><field name=\"NAME\">ClearForm</field><statement name=\"STACK\"><block type=\"component_set_property\" id=\"clear_txt_input\"><mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtInput\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">txtInput</field><field name=\"PROPERTY\">Text</field><value name=\"VALUE\"><block type=\"text\" id=\"t_clear_input\"><field name=\"TEXT\"></field></block></value><next><block type=\"component_set_property\" id=\"clear_img_qrcode\"><mutation component_type=\"Image\" property_name=\"Picture\" instance_name=\"imgQRCode\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">imgQRCode</field><field name=\"PROPERTY\">Picture</field><value name=\"VALUE\"><block type=\"text\" id=\"t_clear_image\"><field name=\"TEXT\"></field></block></value><next><block type=\"lexical_variable_set\" id=\"clear_qr_url\"><field name=\"VAR\">qrURL</field><value name=\"VALUE\"><block type=\"text\" id=\"t_clear_qr_url\"><field name=\"TEXT\"></field></block></value><next><block type=\"lexical_variable_set\" id=\"clear_input_text\"><field name=\"VAR\">inputText</field><value name=\"VALUE\"><block type=\"text\" id=\"t_clear_input_text\"><field name=\"TEXT\"></field></block></value></block></next></block></next></block></next></block></statement></block>\n</xml>"
