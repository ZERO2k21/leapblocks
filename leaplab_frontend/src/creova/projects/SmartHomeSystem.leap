/block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_timer\"><mutation component_type=\"Clock\" event_name=\"Timer\" instance_name=\"Clock1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Clock1</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_timer_conn\"><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_timer_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_timer\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_timer\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_refresh_timer\"><mutation name=\"RefreshDashboard\"></mutation><field name=\"NAME\">RefreshDashboard</field></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_led_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnLED\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnLED</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_led_click_conn\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_led_click_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_led_c\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_led_c\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_toggle_led\"><mutation name=\"ToggleLED\"></mutation><field name=\"NAME\">ToggleLED</field></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_led_c_fail\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generi