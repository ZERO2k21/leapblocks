  "blockLogic": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n<block type=\"global_declaration\" id=\"g_base_url\"><field name=\"NAME\">baseURL</field><value name=\"VALUE\"><block type=\"text\" id=\"init_base_url\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"global_declaration\" id=\"g_conn_status\"><field name=\"NAME\">connectionStatus</field><value name=\"VALUE\"><block type=\"text\" id=\"init_conn_status\"><field name=\"TEXT\">Disconnected</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_led_state\"><field name=\"NAME\">ledState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_led_state\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_fan_state\"><field name=\"NAME\">fanState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_fan_state\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_door_state\"><field name=\"NAME\">doorState</field><value name=\"VALUE\"><block type=\"text\" id=\"init_door_state\"><field name=\"TEXT\">Locked</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_pump_state\"><field name=\"NAME\">pumpState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_pump_state\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_alarm_state\"><field name=\"NAME\">alarmState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_alarm_state\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"component_event\" id=\"evt_init\"><mutation component_type=\"Screen\" event_name=\"Initialize\" instance_name=\"Screen1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Screen1</field><statement name=\"DO\"><block type=\"component_method\" id=\"alert_welcome\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" ins