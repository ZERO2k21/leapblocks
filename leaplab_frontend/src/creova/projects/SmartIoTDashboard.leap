  "blockLogic": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n<block type=\"global_declaration\" id=\"g_base_url\"><field name=\"NAME\">baseURL</field><value name=\"VALUE\"><block type=\"text\" id=\"init_base_url\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"global_declaration\" id=\"g_conn_status\"><field name=\"NAME\">connectionStatus</field><value name=\"VALUE\"><block type=\"text\" id=\"init_conn_status\"><field name=\"TEXT\">Disconnected</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_led\"><field name=\"NAME\">ledState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_led\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_fan\"><field name=\"NAME\">fanState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_fan\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_pump\"><field name=\"NAME\">pumpState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_pump\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_buzzer\"><field name=\"NAME\">buzzerState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_buzzer\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_dash_data\"><field name=\"NAME\">dashboardData</field><value name=\"VALUE\"><block type=\"text\" id=\"init_dash_data\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"component_event\" id=\"evt_init\"><mutation component_type=\"Screen\" event_name=\"Initialize\" instance_name=\"Screen1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Screen1</field><statement name=\"DO\"><block type=\"component_method\" id=\"alert_welcome\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_welcome\"><field name=\"TEXT\">Welcome to Smart IoT Dashboard</field></block></value></block></statement></block>\n<block type=\"component_event\" id=\"evt_connect_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnConnect\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnConnect</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_proc_connect\"><mutation name=\"ConnectESP32\"></mutation><field name=\"NAME\">ConnectESP32</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_refresh_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnRefresh\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnRefresh</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_proc_refresh\"><mutation name=\"RefreshDashboard\"></mutation><field name=\"NAME\">RefreshDashboard</field></block></statement></block>\n<block type=\"component_event\" id=\"evt_timer\"><mutation component_type=\"Clock\" event_name=\"Timer\" instance_name=\"Clock1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Clock1</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_timer_conn\"><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_timer_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_timer\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_timer\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_refresh_timer\"><mutation name=\"RefreshDashboard\"></mutation><field name=\"NAME\">RefreshDashboard</field></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_led_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnLED\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnLED</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_led_click_conn\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_led_click_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_led_c\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_led_c\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_toggle_led_c\"><mutation name=\"ToggleLED\"></mutation><field name=\"NAME\">ToggleLED</field></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_led_c_fail\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_led_c_fail\"><field name=\"TEXT\">Please Connect to ESP32 First</field></block></value></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_fan_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnFan\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnFan</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_fan_click_conn\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_fan_click_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_fan_c\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_fan_c\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_toggle_fan_c\"><mutation name=\"ToggleFan\"></mutation><field name=\"NAME\">ToggleFan</field></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_fan_c_fail\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_fan_c_fail\"><field name=\"TEXT\">Please Connect to ESP32 First</field></block></value></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_pump_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnPump\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnPump</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_pump_click_conn\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_pump_click_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_pump_c\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_pump_c\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_toggle_pump_c\"><mutation name=\"TogglePump\"></mutation><field name=\"NAME\">TogglePump</field></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_pump_c_fail\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_pump_c_fail\"><field name=\"TEXT\">Please Connect to ESP32 First</field></block></value></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_buzzer_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnBuzzer\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnBuzzer</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_buzzer_click_conn\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_buzzer_click_conn_ok\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_conn_status_buzzer_c\"><field name=\"VAR\">connectionStatus</field></block></value><value name=\"B\"><block type=\"text\" id=\"t_conn_ok_buzzer_c\"><field name=\"TEXT\">Connected</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_toggle_buzzer_c\"><mutation name=\"ToggleBuzzer\"></mutation><field name=\"NAME\">ToggleBuzzer</field></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_buzzer_c_fail\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_alert_buzzer_c_fail\"><field name=\"TEXT\">Please Connect to ESP32 First</field></block></value></block></statement></block></statement></block>\n<block type=\"component_event\" id=\"evt_got_text\"><mutation component_type=\"Web\" event_name=\"GotText\" instance_name=\"Web1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Web1</field><statement name=\"DO\"><block type=\"controls_if\" id=\"if_resp_ok\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_resp_200\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"lexical_variable_get\" id=\"get_code_arg\"><field name=\"VAR\">responseCode</field></block></value><value name=\"B\"><block type=\"math_number\" id=\"n_200\"><field name=\"NUM\">200</field></block></value></block></value><statement name=\"DO0\"><block type=\"controls_if\" id=\"if_is_dashboard\"><mutation else=\"1\"></mutation><value name=\"IF0\"><block type=\"logic_compare\" id=\"cmp_is_dash\"><field name=\"OP\">NEQ</field><value name=\"A\"><block type=\"text_indexOf\" id=\"io_dash\"><value name=\"VALUE\"><block type=\"lexical_variable_get\" id=\"get_url_arg\"><field name=\"VAR\">url</field></block></value><value name=\"FIND\"><block type=\"text\" id=\"t_dash_got\"><field name=\"TEXT\">/dashboard</field></block></value></block></value><value name=\"B\"><block type=\"math_number\" id=\"n_0_dash\"><field name=\"NUM\">0</field></block></value></block></value><statement name=\"DO0\"><block type=\"procedures_callnoreturn\" id=\"call_parse_json_got\"><mutation name=\"ParseJSON\"><arg name=\"jsonText\"></arg></mutation><field name=\"NAME\">ParseJSON</field><value name=\"ARG0\"><block type=\"lexical_variable_get\" id=\"get_content_arg\"><field name=\"VAR\">responseContent</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"component_method\" id=\"alert_command_success\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_cmd_success\"><field name=\"TEXT\">Command Sent Successfully!</field></block></value><next><block type=\"procedures_callnoreturn\" id=\"call_refresh_after_cmd\"><mutation name=\"RefreshDashboard\"></mutation><field name=\"NAME\">RefreshDashboard</field></block></next></block></statement></block></statement><statement name=\"ELSE\"><block type=\"lexical_variable_set\" id=\"set_status_disconnected_got\"><field name=\"VAR\">connectionStatus</field><value name=\"VALUE\"><block type=\"text\" id=\"t_status_disconnected_got_val\"><field name=\"TEXT\">Disconnected</field></block></value><next><block type=\"procedures_callnoreturn\" id=\"call_update_status_got\"><mutation name=\"UpdateStatus\"></mutation><fie