  "blockLogic": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n<block type=\"global_declaration\" id=\"g_base_url\"><field name=\"NAME\">baseURL</field><value name=\"VALUE\"><block type=\"text\" id=\"init_base_url\"><field name=\"TEXT\"></field></block></value></block>\n<block type=\"global_declaration\" id=\"g_flash\"><field name=\"NAME\">flashState</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"init_flash\"><field name=\"BOOL\">FALSE</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_rotation\"><field name=\"NAME\">rotationAngle</field><value name=\"VALUE\"><block type=\"math_number\" id=\"init_rotation\"><field name=\"NUM\">0</field></block></value></block>\n<block type=\"global_declaration\" id=\"g_conn_status\"><field name=\"NAME\">connectionStatus</field><value name=\"VALUE\"><block type=\"text\" id=\"init_conn_status\"><field name=\"TEXT\">Disconnected</field></block></value></block>\n<block type=\"component_event\" id=\"evt_init\"><mutation component_type=\"Screen\" event_name=\"Initialize\" instance_name=\"Screen1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Screen1</field><statement name=\"DO\"><block type=\"component_method\" id=\"alert_welcome\"><mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">Notifier1</field><value name=\"ARG_notice\"><block type=\"text\" id=\"t_welcome\"><field name=\"TEXT\">Welcome to ESP32 Camera Surveillance</field></block></value></block></statement></block>\n<block type=\"component_event\" id=\"evt_connect_click\"><mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnConnect\" is_generic=\"false\"></mutation><field name=\"INSTANCE\">btnConnect</field><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"call_proc_connect\"><mutation name=\"ConnectCamera\"></mutation><field name=\"NAME\">ConnectCamera</field></block></statement></