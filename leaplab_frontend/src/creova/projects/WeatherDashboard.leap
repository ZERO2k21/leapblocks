  "blockLogic": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <!-- Screen1 Initialize -->\n  <block type=\"component_event\" id=\"screen_init\" x=\"50\" y=\"50\">\n    <mutation component_type=\"Screen\" event_name=\"Initialize\" instance_name=\"Screen1\" is_generic=\"false\"></mutation>\n    <field name=\"INSTANCE\">Screen1</field>\n    <statement name=\"DO\">\n      <block type=\"component_set_property\" id=\"hide_loading_init\">\n        <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n        <field name=\"INSTANCE\">loading</field>\n        <field name=\"PROPERTY\">Visible</field>\n        <value name=\"VALUE\">\n          <block type=\"logic_boolean\" id=\"init_visible_false\">\n            <field name=\"BOOL\">FALSE</field>\n          </block>\n        </value>\n        <next>\n          <block type=\"component_method\" id=\"notifier_welcome\">\n            <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">Notifier1</field>\n            <value name=\"ARG_notice\">\n              <block type=\"text\" id=\"welcome_text\">\n                <field name=\"TEXT\">Welcome to Weather Dashboard</field>\n              </block>\n            </value>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n\n  <!-- btnSearch Click -->\n  <block type=\"component_event\" id=\"btn_search_click\" x=\"50\" y=\"250\">\n    <mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnSearch\" is_generic=\"false\"></mutation>\n    <field name=\"INSTANCE\">btnSearch</field>\n    <statement name=\"DO\">\n      <block type=\"controls_if\" id=\"if_city_empty\">\n        <mutation else=\"1\"></mutation>\n        <value name=\"IF0\">\n          <block type=\"logic_compare\" id=\"compare_city_empty\">\n            <field name=\"OP\">EQ</field>\n            <value name=\"A\">\n              <block type=\"component_get_property\" id=\"get_city_text\">\n                <mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtCity\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">txtCity</field>\n                <field name=\"PROPERTY\">Text</field>\n              </block>\n            </value>\n            <value name=\"B\">\n              <block type=\"text\" id=\"empty_text\">\n                <field name=\"TEXT\"></field>\n              </block>\n            </value>\n          </block>\n        </value>\n        <statement name=\"DO0\">\n          <block type=\"component_method\" id=\"notifier_empty_city\">\n            <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">Notifier1</field>\n            <value name=\"ARG_notice\">\n              <block type=\"text\" id=\"alert_empty_city\">\n                <field name=\"TEXT\">Please Enter City Name</field>\n              </block>\n            </value>\n          </block>\n        </statement>\n        <statement name=\"ELSE\">\n          <block type=\"component_set_property\" id=\"show_loading_search\">\n            <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">loading</field>\n            <field name=\"PROPERTY\">Visible</field>\n            <value name=\"VALUE\">\n              <block type=\"logic_boolean\" id=\"search_visible_true\">\n                <field name=\"BOOL\">TRUE</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"component_set_property\" id=\"set_webgeo_url\">\n                <mutation component_type=\"Web\" property_name=\"Url\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">WebGeo</field>\n                <field name=\"PROPERTY\">Url</field>\n                <value name=\"VALUE\">\n                  <block type=\"text_join\" id=\"join_webgeo_url\">\n                    <mutation items=\"3\"></mutation>\n                    <value name=\"ADD0\">\n                      <block type=\"text\" id=\"geo_url_prefix\">\n                        <field name=\"TEXT\">https://geocoding-api.open-meteo.com/v1/search?name=</field>\n                      </block>\n                    </value>\n                    <value name=\"ADD1\">\n                      <block type=\"component_method\" id=\"encode_city_text\">\n                        <mutation component_type=\"Web\" method_name=\"UriEncode\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                        <field name=\"INSTANCE\">WebGeo</field>\n                        <value name=\"ARG_text\">\n                          <block type=\"component_get_property\" id=\"get_city_text_api\">\n                            <mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtCity\" is_generic=\"false\"></mutation>\n                            <field name=\"INSTANCE\">txtCity</field>\n                            <field name=\"PROPERTY\">Text</field>\n                          </block>\n                        </value>\n                      </block>\n                    </value>\n                    <value name=\"ADD2\">\n                      <block type=\"text\" id=\"geo_url_suffix\">\n                        <field name=\"TEXT\">&amp;count=1</field>\n                      </block>\n                    </value>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"component_method\" id=\"call_webgeo_get\">\n                    <mutation component_type=\"Web\" method_name=\"Get\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                    <field name=\"INSTANCE\">WebGeo</field>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n\n  <!-- btnRefresh Click -->\n  <block type=\"component_event\" id=\"btn_refresh_click\" x=\"650\" y=\"250\">\n    <mutation component_type=\"Button\" event_name=\"Click\" instance_name=\"btnRefresh\" is_generic=\"false\"></mutation>\n    <field name=\"INSTANCE\">btnRefresh</field>\n    <statement name=\"DO\">\n      <block type=\"controls_if\" id=\"if_city_empty_ref\">\n        <mutation else=\"1\"></mutation>\n        <value name=\"IF0\">\n          <block type=\"logic_compare\" id=\"compare_city_empty_ref\">\n            <field name=\"OP\">EQ</field>\n            <value name=\"A\">\n              <block type=\"component_get_property\" id=\"get_city_text_ref\">\n                <mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtCity\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">txtCity</field>\n                <field name=\"PROPERTY\">Text</field>\n              </block>\n            </value>\n            <value name=\"B\">\n              <block type=\"text\" id=\"empty_text_ref\">\n                <field name=\"TEXT\"></field>\n              </block>\n            </value>\n          </block>\n        </value>\n        <statement name=\"DO0\">\n          <block type=\"component_method\" id=\"notifier_empty_city_ref\">\n            <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">Notifier1</field>\n            <value name=\"ARG_notice\">\n              <block type=\"text\" id=\"alert_empty_city_ref\">\n                <field name=\"TEXT\">Please Enter City Name</field>\n              </block>\n            </value>\n          </block>\n        </statement>\n        <statement name=\"ELSE\">\n          <block type=\"component_set_property\" id=\"show_loading_ref\">\n            <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">loading</field>\n            <field name=\"PROPERTY\">Visible</field>\n            <value name=\"VALUE\">\n              <block type=\"logic_boolean\" id=\"ref_visible_true\">\n                <field name=\"BOOL\">TRUE</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"component_set_property\" id=\"set_webgeo_url_ref\">\n                <mutation component_type=\"Web\" property_name=\"Url\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">WebGeo</field>\n                <field name=\"PROPERTY\">Url</field>\n                <value name=\"VALUE\">\n                  <block type=\"text_join\" id=\"join_webgeo_url_ref\">\n                    <mutation items=\"3\"></mutation>\n                    <value name=\"ADD0\">\n                      <block type=\"text\" id=\"geo_url_prefix_ref\">\n                        <field name=\"TEXT\">https://geocoding-api.open-meteo.com/v1/search?name=</field>\n                      </block>\n                    </value>\n                    <value name=\"ADD1\">\n                      <block type=\"component_method\" id=\"encode_city_text_ref\">\n                        <mutation component_type=\"Web\" method_name=\"UriEncode\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                        <field name=\"INSTANCE\">WebGeo</field>\n                        <value name=\"ARG_text\">\n                          <block type=\"component_get_property\" id=\"get_city_text_api_ref\">\n                            <mutation component_type=\"TextBox\" property_name=\"Text\" instance_name=\"txtCity\" is_generic=\"false\"></mutation>\n                            <field name=\"INSTANCE\">txtCity</field>\n                            <field name=\"PROPERTY\">Text</field>\n                          </block>\n                        </value>\n                      </block>\n                    </value>\n                    <value name=\"ADD2\">\n                      <block type=\"text\" id=\"geo_url_suffix_ref\">\n                        <field name=\"TEXT\">&amp;count=1</field>\n                      </block>\n                    </value>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"component_method\" id=\"call_webgeo_get_ref\">\n                    <mutation component_type=\"Web\" method_name=\"Get\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                    <field name=\"INSTANCE\">WebGeo</field>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n\n  <!-- WebGeo GotText -->\n  <block type=\"component_event\" id=\"webgeo_got_text\" x=\"50\" y=\"700\">\n    <mutation component_type=\"Web\" event_name=\"GotText\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n    <field name=\"INSTANCE\">WebGeo</field>\n    <statement name=\"DO\">\n      <block type=\"controls_if\" id=\"if_geo_success\">\n        <mutation else=\"1\"></mutation>\n        <value name=\"IF0\">\n          <block type=\"logic_compare\" id=\"compare_geo_code\">\n            <field name=\"OP\">EQ</field>\n            <value name=\"A\">\n              <block type=\"lexical_variable_get\" id=\"get_geo_code\">\n                <field name=\"VAR\">responseCode</field>\n              </block>\n            </value>\n            <value name=\"B\">\n              <block type=\"math_number\" id=\"num_200\">\n                <field name=\"NUM\">200</field>\n              </block>\n            </value>\n          </block>\n        </value>\n        <statement name=\"DO0\">\n          <block type=\"local_declaration_statement\" id=\"decl_geo_data\">\n            <mutation>\n              <localname name=\"geo_data\"></localname>\n            </mutation>\n            <value name=\"DECL\">\n              <block type=\"component_method\" id=\"geo_json_decode\">\n                <mutation component_type=\"Web\" method_name=\"JsonTextDecode\" instance_name=\"WebGeo\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">WebGeo</field>\n                <value name=\"ARG_jsonText\">\n                  <block type=\"lexical_variable_get\" id=\"get_geo_content\">\n                    <field name=\"VAR\">responseContent</field>\n                  </block>\n                </value>\n              </block>\n            </value>\n            <statement name=\"STACK\">\n              <block type=\"local_declaration_statement\" id=\"decl_results\">\n                <mutation>\n                  <localname name=\"results\"></localname>\n                </mutation>\n                <value name=\"DECL\">\n                  <block type=\"dictionaries_lookup\" id=\"lookup_results\">\n                    <value name=\"DICT\">\n                      <block type=\"lexical_variable_get\" id=\"get_geo_data_var\">\n                        <field name=\"VAR\">geo_data</field>\n                      </block>\n                    </value>\n                    <value name=\"KEY\">\n                      <block type=\"text\" id=\"key_results\">\n                        <field name=\"TEXT\">results</field>\n                      </block>\n                    </value>\n                    <value name=\"NOTFOUND\">\n                      <block type=\"text\" id=\"empty_string_res\">\n                        <field name=\"TEXT\"></field>\n                      </block>\n                    </value>\n                  </block>\n                </value>\n                <statement name=\"STACK\">\n                  <block type=\"controls_if\" id=\"if_has_results\">\n                    <mutation else=\"1\"></mutation>\n                    <value name=\"IF0\">\n                      <block type=\"logic_compare\" id=\"compare_results_not_empty\">\n                        <field name=\"OP\">NEQ</field>\n                        <value name=\"A\">\n                          <block type=\"lexical_variable_get\" id=\"get_results_var\">\n                            <field name=\"VAR\">results</field>\n                          </block>\n                        </value>\n                        <value name=\"B\">\n                          <block type=\"text\" id=\"empty_string_comp\">\n                            <field name=\"TEXT\"></field>\n                          </block>\n                        </value>\n                      </block>\n                    </value>\n                    <statement name=\"DO0\">\n                      <block type=\"local_declaration_statement\" id=\"decl_first_result\">\n                        <mutation>\n                          <localname name=\"first_result\"></localname>\n                        </mutation>\n                        <value name=\"DECL\">\n                          <block type=\"lists_getIndex\" id=\"get_index_1\">\n                            <value name=\"LIST\">\n                              <block type=\"lexical_variable_get\" id=\"get_results_var2\">\n                                <field name=\"VAR\">results</field>\n                              </block>\n                            </value>\n                            <value name=\"INDEX\">\n                              <block type=\"math_number\" id=\"num_1\">\n                                <field name=\"NUM\">1</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <statement name=\"STACK\">\n                          <block type=\"local_declaration_statement\" id=\"decl_lat_lon\">\n                            <mutation>\n                              <localname name=\"lat\"></localname>\n                              <localname name=\"lon\"></localname>\n                              <localname name=\"name\"></localname>\n                            </mutation>\n                            <value name=\"DECL\">\n                              <block type=\"dictionaries_lookup\" id=\"lookup_lat\">\n                                <value name=\"DICT\">\n                                  <block type=\"lexical_variable_get\" id=\"get_first_result_var\">\n                                    <field name=\"VAR\">first_result</field>\n                                  </block>\n                                </value>\n                                <value name=\"KEY\">\n                                  <block type=\"text\" id=\"key_latitude\">\n                                    <field name=\"TEXT\">latitude</field>\n                                  </block>\n                                </value>\n                                <value name=\"NOTFOUND\">\n                                  <block type=\"math_number\" id=\"num_0_lat\">\n                                    <field name=\"NUM\">0</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </value>\n                            <value name=\"DECL1\">\n                              <block type=\"dictionaries_lookup\" id=\"lookup_lon\">\n                                <value name=\"DICT\">\n                                  <block type=\"lexical_variable_get\" id=\"get_first_result_var2\">\n                                    <field name=\"VAR\">first_result</field>\n                                  </block>\n                                </value>\n                                <value name=\"KEY\">\n                                  <block type=\"text\" id=\"key_longitude\">\n                                    <field name=\"TEXT\">longitude</field>\n                                  </block>\n                                </value>\n                                <value name=\"NOTFOUND\">\n                                  <block type=\"math_number\" id=\"num_0_lon\">\n                                    <field name=\"NUM\">0</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </value>\n                            <value name=\"DECL2\">\n                              <block type=\"dictionaries_lookup\" id=\"lookup_name\">\n                                <value name=\"DICT\">\n                                  <block type=\"lexical_variable_get\" id=\"get_first_result_var3\">\n                                    <field name=\"VAR\">first_result</field>\n                                  </block>\n                                </value>\n                                <value name=\"KEY\">\n                                  <block type=\"text\" id=\"key_name\">\n                                    <field name=\"TEXT\">name</field>\n                                  </block>\n                                </value>\n                                <value name=\"NOTFOUND\">\n                                  <block type=\"text\" id=\"unknown_city\">\n                                    <field name=\"TEXT\">Unknown</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </value>\n                            <statement name=\"STACK\">\n                              <block type=\"component_set_property\" id=\"set_lbl_city\">\n                                <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblCity\" is_generic=\"false\"></mutation>\n                                <field name=\"INSTANCE\">lblCity</field>\n                                <field name=\"PROPERTY\">Text</field>\n                                <value name=\"VALUE\">\n                                  <block type=\"text_join\" id=\"join_city\">\n                                    <mutation items=\"2\"></mutation>\n                                    <value name=\"ADD0\">\n                                      <block type=\"text\" id=\"city_prefix\">\n                                        <field name=\"TEXT\">City : </field>\n                                      </block>\n                                    </value>\n                                    <value name=\"ADD1\">\n                                      <block type=\"lexical_variable_get\" id=\"get_name_val\">\n                                        <field name=\"VAR\">name</field>\n                                      </block>\n                                    </value>\n                                  </block>\n                                </value>\n                                <next>\n                                  <block type=\"component_set_property\" id=\"set_lbl_lat\">\n                                    <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblLatitude\" is_generic=\"false\"></mutation>\n                                    <field name=\"INSTANCE\">lblLatitude</field>\n                                    <field name=\"PROPERTY\">Text</field>\n                                    <value name=\"VALUE\">\n                                      <block type=\"text_join\" id=\"join_lat\">\n                                        <mutation items=\"2\"></mutation>\n                                        <value name=\"ADD0\">\n                                          <block type=\"text\" id=\"lat_prefix\">\n                                            <field name=\"TEXT\">Latitude : </field>\n                                          </block>\n                                        </value>\n                                        <value name=\"ADD1\">\n                                          <block type=\"lexical_variable_get\" id=\"get_lat_val\">\n                                            <field name=\"VAR\">lat</field>\n                                          </block>\n                                        </value>\n                                      </block>\n                                    </value>\n                                    <next>\n                                      <block type=\"component_set_property\" id=\"set_lbl_lon\">\n                                        <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblLongitude\" is_generic=\"false\"></mutation>\n                                        <field name=\"INSTANCE\">lblLongitude</field>\n                                        <field name=\"PROPERTY\">Text</field>\n                                        <value name=\"VALUE\">\n                                          <block type=\"text_join\" id=\"join_lon\">\n                                            <mutation items=\"2\"></mutation>\n                                            <value name=\"ADD0\">\n                                              <block type=\"text\" id=\"lon_prefix\">\n                                                <field name=\"TEXT\">Longitude : </field>\n                                              </block>\n                                            </value>\n                                            <value name=\"ADD1\">\n                                              <block type=\"lexical_variable_get\" id=\"get_lon_val\">\n                                                <field name=\"VAR\">lon</field>\n                                              </block>\n                                            </value>\n                                          </block>\n                                        </value>\n                                        <next>\n                                          <block type=\"component_set_property\" id=\"set_webweather_url\">\n                                            <mutation component_type=\"Web\" property_name=\"Url\" instance_name=\"WebWeather\" is_generic=\"false\"></mutation>\n                                            <field name=\"INSTANCE\">WebWeather</field>\n                                            <field name=\"PROPERTY\">Url</field>\n                                            <value name=\"VALUE\">\n                                              <block type=\"text_join\" id=\"join_webweather_url\">\n                                                <mutation items=\"5\"></mutation>\n                                                <value name=\"ADD0\">\n                                                  <block type=\"text\" id=\"weather_url_prefix\">\n                                                    <field name=\"TEXT\">https://api.open-meteo.com/v1/forecast?latitude=</field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD1\">\n                                                  <block type=\"lexical_variable_get\" id=\"get_lat_val2\">\n                                                    <field name=\"VAR\">lat</field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD2\">\n                                                  <block type=\"text\" id=\"weather_url_mid\">\n                                                    <field name=\"TEXT\">&amp;longitude=</field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD3\">\n                                                  <block type=\"lexical_variable_get\" id=\"get_lon_val2\">\n                                                    <field name=\"VAR\">lon</field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD4\">\n                                                  <block type=\"text\" id=\"weather_url_suffix\">\n                                                    <field name=\"TEXT\">&amp;current=temperature_2m,relative_humidity_2m,apparent_temperature,pressure_msl,wind_speed_10m,weather_code</field>\n                                                  </block>\n                                                </value>\n                                              </block>\n                                            </value>\n                                            <next>\n                                              <block type=\"component_method\" id=\"call_webweather_get\">\n                                                <mutation component_type=\"Web\" method_name=\"Get\" instance_name=\"WebWeather\" is_generic=\"false\"></mutation>\n                                                <field name=\"INSTANCE\">WebWeather</field>\n                                              </block>\n                                            </next>\n                                          </block>\n                                        </next>\n                                      </block>\n                                    </next>\n                                  </block>\n                                </next>\n                              </block>\n                            </statement>\n                          </block>\n                        </statement>\n                      </block>\n                    </statement>\n                    <statement name=\"ELSE\">\n                      <block type=\"component_set_property\" id=\"hide_loading_not_found\">\n                        <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n                        <field name=\"INSTANCE\">loading</field>\n                        <field name=\"PROPERTY\">Visible</field>\n                        <value name=\"VALUE\">\n                          <block type=\"logic_boolean\" id=\"visible_false_not_found\">\n                            <field name=\"BOOL\">FALSE</field>\n                          </block>\n                        </value>\n                        <next>\n                          <block type=\"component_method\" id=\"notifier_not_found\">\n                            <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n                            <field name=\"INSTANCE\">Notifier1</field>\n                            <value name=\"ARG_notice\">\n                              <block type=\"text\" id=\"alert_not_found\">\n                                <field name=\"TEXT\">City Not Found</field>\n                              </block>\n                            </value>\n                          </block>\n                        </next>\n                      </block>\n                    </statement>\n                  </block>\n                </statement>\n              </block>\n            </statement>\n          </block>\n        </statement>\n        <statement name=\"ELSE\">\n          <block type=\"component_set_property\" id=\"hide_loading_err\">\n            <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n            <field name=\"INSTANCE\">loading</field>\n            <field name=\"PROPERTY\">Visible</field>\n            <value name=\"VALUE\">\n              <block type=\"logic_boolean\" id=\"visible_false_err\">\n                <field name=\"BOOL\">FALSE</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"component_method\" id=\"notifier_api_err\">\n                <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">Notifier1</field>\n                <value name=\"ARG_notice\">\n                  <block type=\"text\" id=\"alert_api_err\">\n                    <field name=\"TEXT\">Unable to Retrieve Weather Data</field>\n                  </block>\n                </value>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n\n  <!-- WebWeather GotText -->\n  <block type=\"component_event\" id=\"webweather_got_text\" x=\"50\" y=\"1500\">\n    <mutation component_type=\"Web\" event_name=\"GotText\" instance_name=\"WebWeather\" is_generic=\"false\"></mutation>\n    <field name=\"INSTANCE\">WebWeather</field>\n    <statement name=\"DO\">\n      <block type=\"component_set_property\" id=\"hide_loading_weather\">\n        <mutation component_type=\"CircularProgress\" property_name=\"Visible\" instance_name=\"loading\" is_generic=\"false\"></mutation>\n        <field name=\"INSTANCE\">loading</field>\n        <field name=\"PROPERTY\">Visible</field>\n        <value name=\"VALUE\">\n          <block type=\"logic_boolean\" id=\"visible_false_weather\">\n            <field name=\"BOOL\">FALSE</field>\n          </block>\n        </value>\n        <next>\n          <block type=\"controls_if\" id=\"if_weather_success\">\n            <mutation else=\"1\"></mutation>\n            <value name=\"IF0\">\n              <block type=\"logic_compare\" id=\"compare_weather_code\">\n                <field name=\"OP\">EQ</field>\n                <value name=\"A\">\n                  <block type=\"lexical_variable_get\" id=\"get_weather_code_res\">\n                    <field name=\"VAR\">responseCode</field>\n                  </block>\n                </value>\n                <value name=\"B\">\n                  <block type=\"math_number\" id=\"num_200_weather\">\n                    <field name=\"NUM\">200</field>\n                  </block>\n                </value>\n              </block>\n            </value>\n            <statement name=\"DO0\">\n              <block type=\"local_declaration_statement\" id=\"decl_weather_data\">\n                <mutation>\n                  <localname name=\"weather_data\"></localname>\n                </mutation>\n                <value name=\"DECL\">\n                  <block type=\"component_method\" id=\"weather_json_decode\">\n                    <mutation component_type=\"Web\" method_name=\"JsonTextDecode\" instance_name=\"WebWeather\" is_generic=\"false\"></mutation>\n                    <field name=\"INSTANCE\">WebWeather</field>\n                    <value name=\"ARG_jsonText\">\n                      <block type=\"lexical_variable_get\" id=\"get_weather_content\">\n                        <field name=\"VAR\">responseContent</field>\n                      </block>\n                    </value>\n                  </block>\n                </value>\n                <statement name=\"STACK\">\n                  <block type=\"local_declaration_statement\" id=\"decl_current\">\n                    <mutation>\n                      <localname name=\"current\"></localname>\n                    </mutation>\n                    <value name=\"DECL\">\n                      <block type=\"dictionaries_lookup\" id=\"lookup_current\">\n                        <value name=\"DICT\">\n                          <block type=\"lexical_variable_get\" id=\"get_weather_data_var\">\n                            <field name=\"VAR\">weather_data</field>\n                          </block>\n                        </value>\n                        <value name=\"KEY\">\n                          <block type=\"text\" id=\"key_current\">\n                            <field name=\"TEXT\">current</field>\n                          </block>\n                        </value>\n                        <value name=\"NOTFOUND\">\n                          <block type=\"text\" id=\"empty_string_curr\">\n                            <field name=\"TEXT\"></field>\n                          </block>\n                        </value>\n                      </block>\n                    </value>\n                    <statement name=\"STACK\">\n                      <block type=\"local_declaration_statement\" id=\"decl_weather_fields\">\n                        <mutation>\n                          <localname name=\"temp\"></localname>\n                          <localname name=\"apparent\"></localname>\n                          <localname name=\"humidity\"></localname>\n                          <localname name=\"pressure\"></localname>\n                          <localname name=\"wind\"></localname>\n                          <localname name=\"wcode\"></localname>\n                        </mutation>\n                        <value name=\"DECL\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_temp\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_temp\">\n                                <field name=\"TEXT\">temperature_2m</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_temp\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"DECL1\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_apparent\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var2\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_apparent\">\n                                <field name=\"TEXT\">apparent_temperature</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_apparent\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"DECL2\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_humidity\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var3\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_humidity\">\n                                <field name=\"TEXT\">relative_humidity_2m</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_humidity\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"DECL3\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_pressure\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var4\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_pressure\">\n                                <field name=\"TEXT\">pressure_msl</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_pressure\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"DECL4\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_wind\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var5\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_wind\">\n                                <field name=\"TEXT\">wind_speed_10m</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_wind\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"DECL5\">\n                          <block type=\"dictionaries_lookup\" id=\"lookup_wcode\">\n                            <value name=\"DICT\">\n                              <block type=\"lexical_variable_get\" id=\"get_current_var6\">\n                                <field name=\"VAR\">current</field>\n                              </block>\n                            </value>\n                            <value name=\"KEY\">\n                              <block type=\"text\" id=\"key_wcode\">\n                                <field name=\"TEXT\">weather_code</field>\n                              </block>\n                            </value>\n                            <value name=\"NOTFOUND\">\n                              <block type=\"text\" id=\"empty_wcode\">\n                                <field name=\"TEXT\">--</field>\n                              </block>\n                            </value>\n                          </block>\n                        </value>\n                        <statement name=\"STACK\">\n                          <block type=\"component_set_property\" id=\"set_lbl_temp\">\n                            <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblTemperature\" is_generic=\"false\"></mutation>\n                            <field name=\"INSTANCE\">lblTemperature</field>\n                            <field name=\"PROPERTY\">Text</field>\n                            <value name=\"VALUE\">\n                              <block type=\"text_join\" id=\"join_temp\">\n                                <mutation items=\"3\"></mutation>\n                                <value name=\"ADD0\">\n                                  <block type=\"text\" id=\"temp_prefix\">\n                                    <field name=\"TEXT\">Temperature : </field>\n                                  </block>\n                                </value>\n                                <value name=\"ADD1\">\n                                  <block type=\"lexical_variable_get\" id=\"get_temp_val\">\n                                    <field name=\"VAR\">temp</field>\n                                  </block>\n                                </value>\n                                <value name=\"ADD2\">\n                                  <block type=\"text\" id=\"temp_unit\">\n                                    <field name=\"TEXT\"> °C</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </value>\n                            <next>\n                              <block type=\"component_set_property\" id=\"set_lbl_feels\">\n                                <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblFeelsLike\" is_generic=\"false\"></mutation>\n                                <field name=\"INSTANCE\">lblFeelsLike</field>\n                                <field name=\"PROPERTY\">Text</field>\n                                <value name=\"VALUE\">\n                                  <block type=\"text_join\" id=\"join_feels\">\n                                    <mutation items=\"3\"></mutation>\n                                    <value name=\"ADD0\">\n                                      <block type=\"text\" id=\"feels_prefix\">\n                                        <field name=\"TEXT\">Feels Like : </field>\n                                      </block>\n                                    </value>\n                                    <value name=\"ADD1\">\n                                      <block type=\"lexical_variable_get\" id=\"get_apparent_val\">\n                                        <field name=\"VAR\">apparent</field>\n                                      </block>\n                                    </value>\n                                    <value name=\"ADD2\">\n                                      <block type=\"text\" id=\"feels_unit\">\n                                        <field name=\"TEXT\"> °C</field>\n                                      </block>\n                                    </value>\n                                  </block>\n                                </value>\n                                <next>\n                                  <block type=\"component_set_property\" id=\"set_lbl_hum\">\n                                    <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblHumidity\" is_generic=\"false\"></mutation>\n                                    <field name=\"INSTANCE\">lblHumidity</field>\n                                    <field name=\"PROPERTY\">Text</field>\n                                    <value name=\"VALUE\">\n                                      <block type=\"text_join\" id=\"join_hum\">\n                                        <mutation items=\"3\"></mutation>\n                                        <value name=\"ADD0\">\n                                          <block type=\"text\" id=\"hum_prefix\">\n                                            <field name=\"TEXT\">Humidity : </field>\n                                          </block>\n                                        </value>\n                                        <value name=\"ADD1\">\n                                          <block type=\"lexical_variable_get\" id=\"get_humidity_val\">\n                                            <field name=\"VAR\">humidity</field>\n                                          </block>\n                                        </value>\n                                        <value name=\"ADD2\">\n                                          <block type=\"text\" id=\"hum_unit\">\n                                            <field name=\"TEXT\"> %</field>\n                                          </block>\n                                        </value>\n                                      </block>\n                                    </value>\n                                    <next>\n                                      <block type=\"component_set_property\" id=\"set_lbl_press\">\n                                        <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblPressure\" is_generic=\"false\"></mutation>\n                                        <field name=\"INSTANCE\">lblPressure</field>\n                                        <field name=\"PROPERTY\">Text</field>\n                                        <value name=\"VALUE\">\n                                          <block type=\"text_join\" id=\"join_press\">\n                                            <mutation items=\"3\"></mutation>\n                                            <value name=\"ADD0\">\n                                              <block type=\"text\" id=\"press_prefix\">\n                                                <field name=\"TEXT\">Pressure : </field>\n                                              </block>\n                                            </value>\n                                            <value name=\"ADD1\">\n                                              <block type=\"lexical_variable_get\" id=\"get_pressure_val\">\n                                                <field name=\"VAR\">pressure</field>\n                                              </block>\n                                            </value>\n                                            <value name=\"ADD2\">\n                                              <block type=\"text\" id=\"press_unit\">\n                                                <field name=\"TEXT\"> hPa</field>\n                                              </block>\n                                            </value>\n                                          </block>\n                                        </value>\n                                        <next>\n                                          <block type=\"component_set_property\" id=\"set_lbl_wind\">\n                                            <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblWind\" is_generic=\"false\"></mutation>\n                                            <field name=\"INSTANCE\">lblWind</field>\n                                            <field name=\"PROPERTY\">Text</field>\n                                            <value name=\"VALUE\">\n                                              <block type=\"text_join\" id=\"join_wind\">\n                                                <mutation items=\"3\"></mutation>\n                                                <value name=\"ADD0\">\n                                                  <block type=\"text\" id=\"wind_prefix\">\n                                                    <field name=\"TEXT\">Wind Speed : </field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD1\">\n                                                  <block type=\"lexical_variable_get\" id=\"get_wind_val\">\n                                                    <field name=\"VAR\">wind</field>\n                                                  </block>\n                                                </value>\n                                                <value name=\"ADD2\">\n                                                  <block type=\"text\" id=\"wind_unit\">\n                                                    <field name=\"TEXT\"> km/h</field>\n                                                  </block>\n                                                </value>\n                                              </block>\n                                            </value>\n                                            <next>\n                                              <block type=\"component_set_property\" id=\"set_lbl_wcode\">\n                                                <mutation component_type=\"Label\" property_name=\"Text\" instance_name=\"lblWeatherCode\" is_generic=\"false\"></mutation>\n                                                <field name=\"INSTANCE\">lblWeatherCode</field>\n                                                <field name=\"PROPERTY\">Text</field>\n                                                <value name=\"VALUE\">\n                                                  <block type=\"text_join\" id=\"join_wcode\">\n                                                    <mutation items=\"2\"></mutation>\n                                                    <value name=\"ADD0\">\n                                                      <block type=\"text\" id=\"wcode_prefix\">\n                                                        <field name=\"TEXT\">Weather Code : </field>\n                                                      </block>\n                                                    </value>\n                                                    <value name=\"ADD1\">\n                                                      <block type=\"lexical_variable_get\" id=\"get_wcode_val\">\n                                                        <field name=\"VAR\">wcode</field>\n                                                      </block>\n                                                    </value>\n                                                  </block>\n                                                </value>\n                                              </block>\n                                            </next>\n                                          </block>\n                                        </next>\n                                      </block>\n                                    </next>\n                                  </block>\n                                </next>\n                              </block>\n                            </next>\n                          </block>\n                        </statement>\n                      </block>\n                    </statement>\n                  </block>\n                </statement>\n              </block>\n            </statement>\n            <statement name=\"ELSE\">\n              <block type=\"component_method\" id=\"notifier_weather_err\">\n                <mutation component_type=\"Notifier\" method_name=\"ShowAlert\" instance_name=\"Notifier1\" is_generic=\"false\"></mutation>\n                <field name=\"INSTANCE\">Notifier1</field>\n                <value name=\"ARG_notice\">\n                  <block type=\"text\" id=\"alert_weather_err\">\n                    <field name=\"TEXT\">Unable to Retrieve Weather Data</field>\n                  </block>\n                </value>\n              </block>\n            </statement>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>",
