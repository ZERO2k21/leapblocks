# Electra Compile Server Configuration

# Server port (default: 3001)
PORT=3001

# Optional: Custom pio binary path (default: `pio` on PATH; the Electron
# app passes the bundled pio.exe, and Docker images pip-install platformio)
# PIO_CLI_PATH=/usr/local/bin/pio

# Optional: Custom libraries directory (default: auto-detected forge-lib/libraries)
# PIO_LIB_DIRS=/path/to/libraries