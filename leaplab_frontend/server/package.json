{
  "name": "leapblocks-server",
  "version": "1.0.0",
  "description": "Unified LeapBlocks server: Arduino compile, transpile, APK build, and TCP proxy",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch server.ts",
    "proxy": "bun run tcp-proxy.ts",
    "start:all": "concurrently \"bun run start\" \"bun run proxy\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.3.4",
    "pako": "^2.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "arduino",
    "esp32",
    "compiler",
    "simulator",
    "electra",
    "leapblocks"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/pako": "^2.0.4"
  }
}
