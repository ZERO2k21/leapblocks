{
  "name": "leapblocks",
  "productName": "leapblocks",
  "version": "1.0.0",
  "description": "LeapBlocks monorepo — block-based coding, App Inventor, Arduino/ESP32, ML",
  "main": "dist/main/index.js",
  "workspaces": [
    "server",
    "src/Electra/server",
    "neura-ml"
  ],
  "scripts": {
    "start": "npm run dev:full",
    "dev": "electron-vite dev",
    "dev:web": "concurrently -n app,server,proxy \"npm run dev:server\" \"npm run proxy\" \"vite --config vite.web.config.ts\"",
    "dev:server": "npm run start -w leapblocks-server",
    "dev:full": "npm run dev:web",
    "proxy": "npm run start:proxy -w electra-compiler-server",
    "build:web": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.web.config.ts",
    "build:electron": "node --max-old-space-size=4096 ./node_modules/electron-vite/bin/electron-vite.js build",
    "dist": "npm run build:electron && node --max-old-space-size=4096 ./node_modules/electron-builder/cli.js",
    "dist:win": "npm run build:electron && node --max-old-space-size=4096 ./node_modules/electron-builder/cli.js --win nsis --x64 && node scripts/fix-icon.js",
    "preview:web": "vite preview --config vite.web.config.ts",
    "lint": "eslint --ext .ts,.tsx .",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.web.config.ts",
    "debug": "electron-vite dev --inspect=5858 --remote-debugging-port=9222",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "download-qemu": "node scripts/download-qemu.js",
    "postinstall": "node scripts/download-qemu.js",
    "sync:pinharness": "node src/Electra/scripts/sync-pinharness.js",
    "watch:pinharness": "node src/Electra/scripts/watch-pinharness.js",
    "ws:install": "npm install",
    "ws:build:server": "npm run build -w leapblocks-server 2>/dev/null || true",
    "ws:build:electra": "npm run build -w electra-compiler-server 2>/dev/null || true"
  },
  "keywords": [],
  "author": {
    "name": "chris jaron",
    "email": "chrisjaron99@gmail.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/web-components-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/fabric": "^5.3.0",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.3",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.3.5",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.3",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@blockly/field-angle": "^6.0.9",
    "@blockly/field-colour": "^6.0.12",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/matter-js": "^0.20.2",
    "@vladmandic/face-api": "^1.7.15",
    "adm-zip": "^0.5.17",
    "avr8js": "^0.21.0",
    "blockly": "^12.5.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "electron-is-dev": "^3.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "fabric": "^7.2.0",
    "fs-extra": "^11.3.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lit": "^3.0.0",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "pako": "^2.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reactflow": "^11.11.4",
    "serialport": "^13.0.0",
    "skulpt": "^1.2.0",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.0",
    "three-bvh-csg": "^0.0.18",
    "uuid": "^13.0.0",
    "wav-encoder": "^1.3.0",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.12"
  },
  "private": true
}
