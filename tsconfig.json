{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES6",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "paths": {
      "@blockly-runtime": [
        "./src/blockly/runtime.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/types/**/*"
  ]
}
