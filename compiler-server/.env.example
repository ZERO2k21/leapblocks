# LeapForge Compile Server Configuration

# Server port (default: 3001)
PORT=3001

# Optional: Custom arduino-cli path
# ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli

# Optional: Custom config file
# ARDUINO_CLI_CONFIG=/path/to/arduino-cli.yaml

# Optional: Custom libraries directory
# FORGE_LIB_LIBRARIES=/path/to/libraries
