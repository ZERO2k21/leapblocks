# Electra environment variables
# Copy to .env and fill in your values

# TCP proxy URL for raw TCP tunnelling (MQTT, custom protocols)
# Deploy server/tcp-proxy.ts to Railway and paste the WSS URL here
VITE_TCP_PROXY_URL=wss://your-tcp-proxy.railway.app

# Cloud compiler server URL
VITE_COMPILE_SERVER=https://your-compile-server.railway.app
